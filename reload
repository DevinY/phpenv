#!/bin/bash
if [[ ! -f .env ]]; then
    echo "Error: .env not found."
    exit 1
fi
source .env
source .functions.sh

DEFAULT_YML=$(default_yml_file)
echo "Reloading web for project: ${PROJECT} (${DEFAULT_YML})..."

if [[ "${DEFAULT_YML}" == "docker-compose-apache" ]]; then
    docker-compose -p "${PROJECT}" exec web sh -c "httpd -k graceful"
else
    docker-compose -p "${PROJECT}" exec web sh -c "nginx -s reload"
fi
